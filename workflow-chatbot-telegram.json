          "assignments": [
            {
              "id": "28f865c9-3b5b-49eb-894e-2e0ed065920f",
              "name": "=queue",
              "value": "={{\n  $json.message.text\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ')\n    .split(',')\n    .map((part, index) => {\n      if(index === 1) return part.trim().toUpperCase(); \n      return part\n        .trim()\n        .split(' ')\n        .map(word => {\n          const lowerWords = ['de','da','do','dos','das','e'];\n          if(lowerWords.includes(word)) return word;\n          return word.charAt(0).toUpperCase() + word.slice(1);\n        })\n        .join(' ');\n    })\n    .join(', ') \n}}\n",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
